<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Ver todo» en las respuestas extensas: /odoo/action-chatbot_assistant.action_chatbot_open_result?active_id=<consulta> -->
    <record id="action_chatbot_open_result" model="ir.actions.server">
        <field name="name">Resultado del asistente</field>
        <field name="model_id" ref="model_chatbot_query_log"/>
        <field name="state">code</field>
        <!-- Con grupo, Odoo no exige permiso de escritura sobre la auditoría: basta con poder leer
             la consulta propia (lo comprueba action_open_result). -->
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="code">action = env["chatbot.query.log"].browse(env.context.get("active_id")).action_open_result()</field>
    </record>
</odoo>
