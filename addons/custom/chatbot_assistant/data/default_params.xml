<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- forcecreate="0": si la fila se borró (y quizá se volvió a crear sin enlace al módulo), la
         actualización no la recrea; así no choca con la restricción de clave única. -->
    <record id="param_chatbot_active" model="ir.config_parameter" forcecreate="0">
        <field name="key">chatbot_assistant.active</field>
        <field name="value">True</field>
    </record>
    <record id="param_chatbot_provider" model="ir.config_parameter" forcecreate="0">
        <field name="key">chatbot_assistant.provider</field>
        <field name="value">gemini</field>
    </record>
    <record id="param_chatbot_model" model="ir.config_parameter" forcecreate="0">
        <field name="key">chatbot_assistant.model</field>
        <field name="value">gemini-3.1-flash-lite</field>
    </record>
    <record id="param_chatbot_temperature" model="ir.config_parameter" forcecreate="0">
        <field name="key">chatbot_assistant.temperature</field>
        <field name="value">0.1</field>
    </record>
    <record id="param_chatbot_timeout" model="ir.config_parameter" forcecreate="0">
        <field name="key">chatbot_assistant.timeout</field>
        <field name="value">20</field>
    </record>
    <record id="param_chatbot_log_retention_days" model="ir.config_parameter" forcecreate="0">
        <field name="key">chatbot_assistant.log_retention_days</field>
        <field name="value">0</field>
    </record>
</odoo>
