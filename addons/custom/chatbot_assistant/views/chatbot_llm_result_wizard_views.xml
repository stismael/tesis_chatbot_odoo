<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatbot_llm_result_wizard_form" model="ir.ui.view">
        <field name="name">chatbot.llm.result.wizard.form</field>
        <field name="model">chatbot.llm.result.wizard</field>
        <field name="arch" type="xml">
            <form string="Resultado LLM">
                <group>
                    <field name="title" readonly="1"/>
                    <field name="suggested_model" readonly="1"
                             invisible="not suggested_model"/>
                </group>
                <separator string="Detalle"/>
                <field name="body" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_apply_suggested"
                            type="object"
                            string="Usar modelo sugerido"
                            class="btn-primary"
                            invisible="not suggested_model"/>
                    <button string="Cerrar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
