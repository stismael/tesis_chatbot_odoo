# Copie este archivo a .env y ajuste los valores marcados como CAMBIAR.

POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_POSTGRES
ODOO_MASTER_PASSWORD=CAMBIAR_MASTER_PASSWORD
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
ODOO_DATABASE=odoo18_chatbot
PROJECT_ROOT=D:/odoo18-community-chatbot
POSTGRES_DATA_PATH=D:/odoo18-community-chatbot/runtime/postgres
ODOO_DATA_PATH=D:/odoo18-community-chatbot/runtime/odoo
ODOO_LOG_PATH=D:/odoo18-community-chatbot/runtime/logs
BACKUP_PATH=D:/odoo18-community-chatbot/backups
