<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_chatbot" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Chatbot asistente" name="chatbot_assistant"
                     groups="base.group_system,chatbot_assistant.group_chatbot_manager">
                    <block title="Proveedor de lenguaje (LLM)">
                        <setting string="Activar asistente" help="Si se desactiva, el chat no enviará consultas al LLM.">
                            <field name="chatbot_active"/>
                        </setting>
                        <setting string="Proveedor" help="Gemini (Google AI Studio) es la opción recomendada para la tesis (free tier).">
                            <field name="chatbot_provider"/>
                        </setting>
                        <setting string="API Key"
                                 help="Clave de Google AI Studio o Groq. Campo oculto (password). No use el .env del Docker.">
                            <field name="chatbot_api_key" password="True"/>
                        </setting>
                        <setting string="Modelo"
                                 help="Solo modelos de texto disponibles del proveedor elegido. Al guardar se prueba la conexión si cambió el proveedor, la API key o el modelo.">
                            <field name="chatbot_llm_model_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="not chatbot_catalog_count"/>
                            <field name="chatbot_model" invisible="chatbot_catalog_count"/>
                            <div class="text-warning mt4" invisible="not chatbot_model_warning">
                                <field name="chatbot_model_warning" class="text-warning"/>
                            </div>
                            <div class="text-muted small mt4">
                                Catálogo actualizado: <field name="chatbot_models_synced" class="d-inline"/>.
                                La API no informa si un modelo es gratuito:
                                <field name="chatbot_pricing_url" widget="url" class="d-inline" text="ver precios del proveedor"/>
                            </div>
                            <div class="mt8">
                                <button name="action_chatbot_sync_models"
                                        type="object"
                                        string="Actualizar modelos"
                                        class="btn-secondary"/>
                                <button name="action_chatbot_test_connection"
                                        type="object"
                                        string="Probar conexión"
                                        class="btn-primary ms-2"/>
                                <button name="%(chatbot_assistant.action_chatbot_llm_model)d"
                                        type="action"
                                        string="Ver catálogo"
                                        class="btn-link ms-2"/>
                            </div>
                        </setting>
                        <setting string="Estado del proveedor"
                                 help="Última verificación de la conexión y última falla registrada en la auditoría.">
                            <div><field name="chatbot_last_verified" class="d-inline"/></div>
                            <div><field name="chatbot_llm_status" class="d-inline"/></div>
                        </setting>
                        <setting string="Temperature" help="Use valores bajos (0.0–0.2) para mayor consistencia en JSON.">
                            <field name="chatbot_temperature"/>
                        </setting>
                        <setting string="Timeout (s)" help="Segundos máximos por intento. Ante demoras se reintenta automáticamente.">
                            <field name="chatbot_timeout"/>
                        </setting>
                    </block>
                    <block title="Auditoría y métricas">
                        <setting string="Conservar auditoría (días)"
                                 help="Los registros de consultas más antiguos se borran automáticamente cada día. Use 0 para conservar todo (recomendado durante la evaluación de la tesis).">
                            <field name="chatbot_log_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_chatbot_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes del chatbot</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'chatbot_assistant'}</field>
    </record>
</odoo>
