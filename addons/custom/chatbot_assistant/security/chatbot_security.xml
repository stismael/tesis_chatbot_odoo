<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatbot" model="ir.module.category">
        <field name="name">Chatbot Assistant</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_chatbot_user" model="res.groups">
        <field name="name">Usuario chatbot</field>
        <field name="category_id" ref="module_category_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_chatbot_manager" model="res.groups">
        <field name="name">Administrador chatbot</field>
        <field name="category_id" ref="module_category_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('group_chatbot_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Usuarios internos pueden usar el chat por defecto -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_chatbot_user'))]"/>
    </record>

    <!-- Cada usuario solo ve sus propias sesiones, mensajes y consultas -->
    <record id="rule_chatbot_session_own" model="ir.rule">
        <field name="name">Chatbot: sesiones propias</field>
        <field name="model_id" ref="model_chatbot_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_chatbot_user'))]"/>
    </record>

    <record id="rule_chatbot_message_own" model="ir.rule">
        <field name="name">Chatbot: mensajes propios</field>
        <field name="model_id" ref="model_chatbot_message"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_chatbot_user'))]"/>
    </record>

    <record id="rule_chatbot_query_log_own" model="ir.rule">
        <field name="name">Chatbot: consultas propias</field>
        <field name="model_id" ref="model_chatbot_query_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_chatbot_user'))]"/>
    </record>

    <!-- El administrador del chatbot ve todo (auditoría) -->
    <record id="rule_chatbot_session_manager" model="ir.rule">
        <field name="name">Chatbot: todas las sesiones (administrador)</field>
        <field name="model_id" ref="model_chatbot_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatbot_manager'))]"/>
    </record>

    <record id="rule_chatbot_message_manager" model="ir.rule">
        <field name="name">Chatbot: todos los mensajes (administrador)</field>
        <field name="model_id" ref="model_chatbot_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatbot_manager'))]"/>
    </record>

    <record id="rule_chatbot_query_log_manager" model="ir.rule">
        <field name="name">Chatbot: todas las consultas (administrador)</field>
        <field name="model_id" ref="model_chatbot_query_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatbot_manager'))]"/>
    </record>
</odoo>
