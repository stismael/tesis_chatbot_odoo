<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chatbot_session_tree" model="ir.ui.view">
        <field name="name">chatbot.session.tree</field>
        <field name="model">chatbot.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="last_intent"/>
                <field name="last_status"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_chatbot_session_form" model="ir.ui.view">
        <field name="name">chatbot.session.form</field>
        <field name="model">chatbot.session</field>
        <field name="arch" type="xml">
            <form string="Asistente conversacional">
                <header>
                    <button name="action_send_message"
                            type="object"
                            string="Enviar"
                            class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_close"
                            type="object"
                            string="Cerrar sesión"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nueva consulta"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="last_intent" readonly="1"/>
                            <field name="last_status" readonly="1"/>
                        </group>
                        <group>
                            <field name="pending_intent" readonly="1"/>
                        </group>
                    </group>
                    <group string="Escriba su consulta" invisible="state != 'open'">
                        <field name="message_input"
                                 nolabel="1"
                                 placeholder="Ej.: ¿Está pagada la factura INV/2026/00001?"
                                 colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Conversación">
                            <field name="message_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="role"/>
                                    <field name="body"/>
                                    <field name="intent"/>
                                    <field name="status"/>
                                    <field name="create_date"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="role"/>
                                        <field name="intent"/>
                                        <field name="status"/>
                                        <field name="body"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatbot_session" model="ir.actions.act_window">
        <field name="name">Sesiones</field>
        <field name="res_model">chatbot.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
